# ── NovaGhost Client — Environment Variables ──────────────────────────────────
# Local-only build. There is NO login/signup and NO cloud server.
# A .env file is entirely OPTIONAL — every setting below can be entered inside
# the app (Preferences tab), and your API keys are saved to
# ~/.novaghost/settings.json on this computer.

# ── Vision API Key (optional pre-fill; set it in Preferences instead) ──────────
# Get a free Gemini key from: https://aistudio.google.com/app/apikey
# Working free-tier models: gemini-2.5-flash-lite, gemini-3.5-flash
# Ollama needs no key (runs locally).
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ── Gesture & Display ─────────────────────────────────────────────────────────
TRIPLE_TAP_WINDOW=0.5
RESPONSE_DURATION=4.0

# ── Hotkey ────────────────────────────────────────────────────────────────────
GLOBAL_SHORTCUT=Ctrl+Shift+S

# ── Stealth (Windows) ─────────────────────────────────────────────────────────
HIDE_PROCESS=true
HIDE_CONSOLE=true
DISABLE_CAPTURE_PROTECTION=false

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG_MODE=false
