# ── Vision API Keys ────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ── Auth Server ────────────────────────────────────────────────────────────────
# Local dev: http://127.0.0.1:5000
# Cloud:     https://<your-worker>.workers.dev
AUTH_SERVER_URL=http://127.0.0.1:5000

# ── Server Security (REQUIRED in production) ───────────────────────────────────
# Strong random string — MUST match between Flask app and Cloudflare Worker env
JWT_SECRET=change_me_before_production

# Secret header value for privileged bootstrap registration
INIT_SECRET=change_me_before_production

# Username protected from ban/delete/password-reset by non-owners
PRIMARY_OWNER=admin

# ── Gesture & Display ─────────────────────────────────────────────────────────
TRIPLE_TAP_WINDOW=0.5
RESPONSE_DURATION=2.0

# ── Hotkey ────────────────────────────────────────────────────────────────────
GLOBAL_SHORTCUT=Ctrl+Shift+S

# ── Stealth (Windows) ─────────────────────────────────────────────────────────
HIDE_PROCESS=true
HIDE_CONSOLE=true
DISABLE_CAPTURE_PROTECTION=false

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG_MODE=false
