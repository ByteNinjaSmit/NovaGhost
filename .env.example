# ── NovaGhost Client — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values (dev only).
# The distributed PortalClient.exe does NOT need a .env file.
# All settings below can be changed inside the app (Preferences tab).

# ── Vision API Key (required to use the scanner) ───────────────────────────────
# Get a free key from: https://aistudio.google.com/app/apikey
# Working free-tier models: gemini-2.5-flash-lite, gemini-3.5-flash
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ── Auth Server ────────────────────────────────────────────────────────────────
# Leave blank to use the default production server (novaghost.twistark.cloud)
# Set this only if running a local/custom server instance
AUTH_SERVER_URL=

# ── Gesture & Display ─────────────────────────────────────────────────────────
TRIPLE_TAP_WINDOW=0.5
RESPONSE_DURATION=4.0

# ── Hotkey ────────────────────────────────────────────────────────────────────
GLOBAL_SHORTCUT=Ctrl+Shift+S

# ── Stealth (Windows) ─────────────────────────────────────────────────────────
HIDE_PROCESS=true
HIDE_CONSOLE=true
DISABLE_CAPTURE_PROTECTION=false

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG_MODE=false
